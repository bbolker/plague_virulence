@article{Cress2016,
	title = {The adaptive evolution of virulence: a review of theoretical predictions and empirical tests},
	volume = {143},
	issn = {0031-1820, 1469-8161},
	shorttitle = {The adaptive evolution of virulence},
	url = {https://www.cambridge.org/core/journals/parasitology/article/adaptive-evolution-of-virulence-a-review-of-theoretical-predictions-and-empirical-tests/30EC8AB1717BF7A173CF5E051DBB498F},
	doi = {10.1017/S003118201500092X},
	abstract = {Why is it that some parasites cause high levels of host damage (i.e. virulence) whereas others are relatively benign? There are now numerous reviews of virulence evolution in the literature but it is nevertheless still difficult to find a comprehensive treatment of the theory and data on the subject that is easily accessible to non-specialists. Here we attempt to do so by distilling the vast theoretical literature on the topic into a set of relatively few robust predictions. We then provide a comprehensive assessment of the available empirical literature that tests these predictions. Our results show that there have been some notable successes in integrating theory and data but also that theory and empiricism in this field do not ‘speak’ to each other very well. We offer a few suggestions for how the connection between the two might be improved.},
	language = {en},
	number = {7},
	urldate = {2022-06-17},
	journal = {Parasitology},
	author = {Cressler, Clayton E. and McLeod, David V. and Rozins, Carly and Hoogen, Josée Van Den and Day, Troy},
	month = jun,
	year = {2016},
	note = {Publisher: Cambridge University Press},
	keywords = {infectious disease, evolutionary medicine, Tradeoff hypothesis},
	pages = {915--930},
	file = {Full Text PDF:/home/bolker/Documents/zotero_new/storage/Y6U3Y8JD/Cressler et al. - 2016 - The adaptive evolution of virulence a review of t.pdf:application/pdf;Snapshot:/home/bolker/Documents/zotero_new/storage/D9IETV3Q/30EC8AB1717BF7A173CF5E051DBB498F.html:text/html},
}


